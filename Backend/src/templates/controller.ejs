// src/templates/controller.ejs
package com.example.<%= projectName %>.controller;

import com.example.<%= projectName %>.domain.<%= EntityName %>;
import com.example.<%= projectName %>.service.<%= EntityName %>Service;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/<%= entityPath %>s")
@CrossOrigin(origins = "*")
public class <%= EntityName %>Controller {

    private final <%= EntityName %>Service service;

    public <%= EntityName %>Controller(<%= EntityName %>Service service) {
        this.service = service;
    }

    // 1. READ ALL
    @GetMapping
    public List<<%= EntityName %>> getAll() {
        return service.findAll();
    }

    // 2. READ BY ID
    @GetMapping("/{id}")
    public ResponseEntity<<%= EntityName %>> getById(@PathVariable Long id) {
        return service.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    // 3. CREATE
    @PostMapping
    public ResponseEntity<<%= EntityName %>> create(@RequestBody <%= EntityName %> entity) {
        return ResponseEntity.ok(service.save(entity));
    }

    // 4. UPDATE 
    @PutMapping("/{id}")
    public ResponseEntity<<%= EntityName %>> update(@PathVariable Long id, @RequestBody <%= EntityName %> entityDetails) {
        return service.findById(id).map(existingEntity -> {
            // Aseguramos que el ID del objeto coincida con la ruta para no crear uno nuevo
            entityDetails.setId(existingEntity.getId());
            return ResponseEntity.ok(service.save(entityDetails));
        }).orElse(ResponseEntity.notFound().build());
    }

    // 5. DELETE
    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        if (service.findById(id).isPresent()) {
            service.deleteById(id);
            return ResponseEntity.noContent().build();
        }
        return ResponseEntity.notFound().build();
    }
}