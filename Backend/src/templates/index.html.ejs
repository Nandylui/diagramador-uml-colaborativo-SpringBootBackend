<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestión - <%= projectName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="#">📦 Sistema</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-secondary">Panel de Administración</h1>
            <p class="text-muted">Seleccione el módulo que desea gestionar</p>
        </div>

        <div class="row justify-content-center">
            <% entidades.forEach(function(entidad) { %>
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="card shadow-sm border-0 h-100 text-center p-3 hover-shadow">
                    <div class="card-body">
                        <h4 class="card-title text-primary fw-bold"><%= entidad %></h4>
                        <p class="text-muted small">Gestionar registros en la base de datos</p>
                        <a href="/<%= entidad.toLowerCase() %>.html" class="btn btn-outline-primary w-100">Abrir Módulo</a>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</body>
</html>