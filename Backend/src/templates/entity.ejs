package com.example.<%= projectName %>.domain;

import jakarta.persistence.*;
<% if (hasLocalDate) { %>import java.time.LocalDate;<% } %>
<% if (hasLocalDateTime) { %>import java.time.LocalDateTime;<% } %>
import java.math.BigDecimal;

@Entity
@Table(name = "<%= tableName %>")
public class <%= EntityName %> {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

<% columns.forEach(function(col) { %>
<% if (col.fieldName.toLowerCase() !== 'id') { %>
<% if (col.name.toLowerCase().startsWith('id_')) { 
     let refName = col.name.toLowerCase().replace('id_', '');
     let RefClass = refName.charAt(0).toUpperCase() + refName.slice(1);
%>
    @ManyToOne
    @JoinColumn(name = "<%= col.name.toLowerCase() %>")
    private <%= RefClass %> <%= refName %>;
<% } else { %>
    @Column(name = "<%= col.name.toLowerCase() %>")
    private <%= col.javaType %> <%= col.fieldName %>;
<% } %>
<% } %>
<% }); %>

<% relations.forEach(function(rel) { %>
    @ManyToOne
    @JoinColumn(name = "<%= rel.colName %>")
    private <%= rel.RefClass %> <%= rel.refName %>;
<% }); %>

    public <%= EntityName %>() {}

    public Long getId() { return id; }
    public void setId(Long id) { this.id = id; }

<% columns.forEach(function(col) { %>
<% if (col.fieldName.toLowerCase() !== 'id') { %>
<% if (col.name.toLowerCase().startsWith('id_')) { 
     let refName = col.name.toLowerCase().replace('id_', '');
     let RefClass = refName.charAt(0).toUpperCase() + refName.slice(1);
%>
    public <%= RefClass %> get<%= RefClass %>() { return this.<%= refName %>; }
    public void set<%= RefClass %>(<%= RefClass %> <%= refName %>) { this.<%= refName %> = <%= refName %>; }
<% } else { %>
    public <%= col.javaType %> get<%= col.FieldNameCapital %>() { return this.<%= col.fieldName %>; }
    public void set<%= col.FieldNameCapital %>(<%= col.javaType %> <%= col.fieldName %>) { this.<%= col.fieldName %> = <%= col.fieldName %>; }
<% } %>
<% } %>
<% }); %>

<% relations.forEach(function(rel) { %>
    public <%= rel.RefClass %> get<%= rel.RefClass %>() { return this.<%= rel.refName %>; }
    public void set<%= rel.RefClass %>(<%= rel.RefClass %> <%= rel.refName %>) { this.<%= rel.refName %> = <%= rel.refName %>; }
<% }); %>
}